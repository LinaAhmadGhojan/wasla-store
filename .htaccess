<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hostinger / LiteSpeed shared hosting
    # Keep project in public_html; serve Laravel from public/ (any domain).

    # Homepage must hit the front controller (avoids 403 on directory listing)
    RewriteRule ^$ public/index.php [L]

    # Everything else into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
